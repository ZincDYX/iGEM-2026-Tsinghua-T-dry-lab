# Copy this file to .env and fill in only the variables you use.
# .env is ignored by Git and must never be committed.

# Optional OpenAI-compatible planning backend (for example, DeepSeek).
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Optional OpenAI-compatible hybrid semantic-decision backend (for example, Qwen).
# The hybrid path emits PlanningDecision JSON, then deterministic code compiles tools.
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3-235b-a22b-instruct-2507

# Optional Literature QA embeddings backend. Leave all three empty for the
# deterministic metadata-aware BM25 path.
QA_EMBEDDING_API_BASE=
QA_EMBEDDING_API_KEY=
QA_EMBEDDING_MODEL=

# Optional one-call Literature QA synthesis backend. This is presentation only:
# it never approves or writes a production ParameterRecord.
QA_SYNTHESIS_API_BASE=
QA_SYNTHESIS_API_KEY=
QA_SYNTHESIS_MODEL=
