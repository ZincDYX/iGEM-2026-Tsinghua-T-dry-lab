{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FusionLab",
  "version": "0.1.0",
  "identifier": "org.fusionlab.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev --host 127.0.0.1",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FusionLab · 融合蛋白研究工作台",
        "visible": false,
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["main-workbench"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": { "active": false }
}
